{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform web",
    "deploy:web": "expo export --platform web --clear && wrangler pages deploy dist --project-name fitness-web --branch main",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "EXPO_PUBLIC_DURABILITY_HARNESS=1 playwright test",
    "test:e2e:durability": "EXPO_PUBLIC_DURABILITY_HARNESS=1 playwright test --project=durability",
    "postinstall": "powersync-web copy-assets -o public"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.26",
    "@expo/vector-icons": "^15.1.1",
    "@fitness/analytics-engine": "workspace:*",
    "@fitness/api-contracts": "workspace:*",
    "@fitness/plate-math": "workspace:*",
    "@fitness/pr-rules": "workspace:*",
    "@fitness/program-generator": "workspace:*",
    "@fitness/progression-engine": "workspace:*",
    "@op-engineering/op-sqlite": "^18.0.0",
    "@powersync/common": "^2.1.0",
    "@powersync/drizzle-driver": "^0.8.0",
    "@powersync/react-native": "^2.1.0",
    "@powersync/web": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "better-auth": "1.6.26",
    "drizzle-orm": "^0.45.2",
    "expo": "57.0.12",
    "expo-asset": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.4",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.14",
    "expo-router": "57.0.12",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "minisearch": "^7.2.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "^9.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.2",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "^57.0.6",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "wrangler": "4.128.0"
  }
}

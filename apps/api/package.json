{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "test": "jest --config jest.config.js",
    "test:e2e": "pnpm run db:push && nest build && jest --config ./test/jest-e2e.json --runInBand",
    "db:verify": "pnpm run test:e2e -- schema-parity"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.26",
    "@fitness/api-contracts": "workspace:*",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.0",
    "nodemailer": "9.0.5",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.1.29",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.0",
    "jest": "^30.0.0",
    "jest-environment-node": "^30.4.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}

DATABASE_URL=postgresql://postgres:dev@localhost:5432/fitness
API_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to send credentialed requests (web build only).
WEB_ORIGINS=http://localhost:8081
BETTER_AUTH_SECRET=replace-with-a-long-random-string
EXPO_PUBLIC_API_URL=http://localhost:3000
MIN_CLIENT_VERSION=0.0.0

# Outbound mail (password reset). MAIL_TRANSPORT selects the adapter -- only "smtp" exists today,
# and it serves both the local Mailpit catcher and a real SMTP-speaking provider via these same
# variables. The catcher listens unauthenticated on 127.0.0.1:1025, so leave SMTP_USER and
# SMTP_PASSWORD empty in development.
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@fitness.example.com
# The deployed web build own origin, where reset-password.web.tsx is served (D-07). The reset
# link mailed to a person always opens this origin in a browser, never a custom app scheme.
WEB_APP_ORIGIN=http://localhost:8081

# Client half of WEB_APP_ORIGIN (D-07). The forgot-password screen points its redirectTo here,
# so it must be the origin the deployed web build is served from. An http or https browser origin
# only -- a custom app scheme is rejected at startup.
EXPO_PUBLIC_WEB_APP_ORIGIN=http://localhost:8081

# The pull half of sync (PLAT-03/PLAT-04). POWERSYNC_URL is the running service's base URL --
# http://localhost:8080 when self-hosted from docker-compose.dev.yml's powersync service, or the
# instance URL from the PowerSync Cloud dashboard. POWERSYNC_JWT_SECRET is a base64url-encoded
# random string shared between this API (which signs tokens) and ops/powersync/powersync.yaml's
# client_auth.jwks (which verifies them) -- generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
POWERSYNC_URL=http://localhost:8080
POWERSYNC_JWT_SECRET=replace-with-a-base64url-encoded-random-string

# The password for the dedicated powersync_role Postgres replication role docker-compose.dev.yml's
# powersync service connects with -- never the app's own DATABASE_URL credentials. Local-dev-only;
# the role itself is created once with CREATE ROLE powersync_role WITH REPLICATION LOGIN PASSWORD.
POWERSYNC_REPLICATION_PASSWORD=replace-with-the-powersync_role-password

# Client half of POWERSYNC_URL (D-07's pattern, applied here) -- must be an origin the browser and
# the device can both reach, not just this machine's loopback.
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:8080
